{
  "compilerOptions": {
    "ignoreDeprecations": "6.0",      // <--- Atualizado para 6.0
    "rootDir": "./src",
    "outDir": "./dist",

    "module": "CommonJS",
    "moduleResolution": "Bundler",    // <--- O modo moderno que não exige .js
    "target": "ESNext",
    "types": ["node"],

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "drizzle.config.ts"]
}